@page "/playlists/{Id:guid}"
@inject PlaylistService Playlists
@inject LibraryService Library
@inject PlayerState Player
@inject IPlayerService Playback
@implements IDisposable
@inject Random Rng

<PageHeader Title="@(playlist?.Name ?? "Playlist")" BackHref="playlists" />

@if (playlist is null)
{
    <p class="px-4 pt-4 text-sm text-mute">This playlist no longer exists.</p>
}
else
{
    <div class="mx-4 mb-2 flex items-center gap-2 rounded-2xl bg-panel2 p-3">
        <div class="min-w-0 flex-1">
            <div class="font-semibold">@(playlist.IsSmart ? "Smart playlist" : "Manual playlist")</div>
            <div class="text-xs text-mute">@LibraryQuery.Pluralize(tracks.Count, "song")@(playlist.IsSmart ? " · refreshes automatically" : "")</div>
        </div>
        <button type="button" class="min-h-12 rounded-xl bg-accent px-4 font-semibold text-accent-fg disabled:opacity-60"
                disabled="@(tracks.Count == 0)" @onclick="PlayFirst">
            <i class="fa-solid fa-play mr-1" aria-hidden="true"></i>Play
        </button>
        <button type="button" aria-label="Shuffle" class="flex size-12 items-center justify-center rounded-xl bg-panel disabled:opacity-60"
                disabled="@(tracks.Count == 0)" @onclick="PlayRandom">
            <i class="fa-solid fa-shuffle" aria-hidden="true"></i>
        </button>
    </div>

    @if (undoTrack is not null)
    {
        <Toast @key="undoTrack.Id" Message="@($"Removed {undoTrack.Title}")" ActionLabel="Undo" OnAction="UndoAsync" OnDismissed="DismissUndo" />
    }

    @if (!playlist.IsSmart)
    {
        <div class="px-4 pb-2">
            <button type="button" class="flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-panel2 font-semibold" @onclick="ToggleAdding">
                <i class="fa-solid fa-plus text-accent" aria-hidden="true"></i>
                Add songs
            </button>
        </div>
    }

    @if (adding)
    {
        <ActionSheet Title="Add songs" Tall="true" CloseLabel="Done" OnClose="ToggleAdding">
            @if (candidates.Count == 0)
            {
                <p class="text-sm text-mute">Every song in your library is already in this playlist.</p>
            }

            @foreach (var track in candidates)
            {
                <div @key="track.Id" class="flex min-h-16 items-center">
                    <div class="min-w-0 flex-1">
                        <SongRow Track="track" OnPlay="AddAsync" />
                    </div>
                    <button type="button" aria-label="@($"Add {track.Title}")" class="flex size-12 shrink-0 items-center justify-center text-accent" @onclick="() => AddAsync(track)">
                        <i class="fa-solid fa-circle-plus text-xl" aria-hidden="true"></i>
                    </button>
                </div>
            }
        </ActionSheet>
    }

    @if (menuTrack is not null)
    {
        <ActionSheet Title="@menuTrack.Title" OnClose="CloseMenu">
            <button type="button" class="flex min-h-12 w-full items-center gap-3 rounded-xl px-3" @onclick="() => Edit(menuTrack)">
                <i class="fa-solid fa-pen w-5 text-center" aria-hidden="true"></i>Edit info
            </button>
        </ActionSheet>
    }

    <TrackEditor Track="editing" OnChanged="ReloadAsync" OnClosed="CloseEditor" />

    @if (tracks.Count == 0)
    {
        <p class="px-4 pt-2 text-sm text-mute">@(playlist.IsSmart ? "No songs match these rules." : "This playlist is empty.")</p>
    }

    <Virtualize Items="tracks" Context="track" ItemSize="64">
        <div @key="track.Id" class="flex min-h-16 items-center">
            <div class="min-w-0 flex-1">
                <SongRow Track="track" IsCurrent="@(Player.Current?.Id == track.Id)" OnPlay="PlayAsync" OnMenu="OpenMenu" />
            </div>
            @if (!playlist.IsSmart)
            {
                <button type="button" aria-label="@($"Remove {track.Title}")" class="flex size-12 shrink-0 items-center justify-center text-mute" @onclick="() => RemoveAsync(track)">
                    <i class="fa-solid fa-circle-minus text-xl" aria-hidden="true"></i>
                </button>
            }
        </div>
    </Virtualize>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Playlist? playlist;
    private List<Track> tracks = [];
    private List<Track> candidates = [];
    private bool adding;
    private Track? undoTrack;
    private Track? menuTrack;
    private Track? editing;

    protected override async Task OnParametersSetAsync()
    {
        playlist = await Playlists.GetAsync(Id);
        undoTrack = null;
        adding = false;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (playlist is null)
        {
            return;
        }

        tracks = [.. await Playlists.GetTracksAsync(Id)];
        var inPlaylist = tracks.Select(track => track.Id).ToHashSet();
        candidates = [.. (await Library.GetAllAsync()).Where(track => !inPlaylist.Contains(track.Id))];
    }

    private IDisposable? playerSubscription;

    protected override void OnInitialized() => playerSubscription = Player.Subscribe(() => InvokeAsync(StateHasChanged));

    public void Dispose() => playerSubscription?.Dispose();

    private Task PlayAsync(Track track) => Playback.PlayFromAsync(tracks, track);

    private Task PlayFirst() => PlayAsync(tracks[0]);

    private Task PlayRandom() => Playback.PlayShuffledAsync(tracks, Rng);

    private void OpenMenu(Track track) => menuTrack = track;

    private void CloseMenu() => menuTrack = null;

    private void Edit(Track track)
    {
        menuTrack = null;
        editing = track;
    }

    private void CloseEditor() => editing = null;

    private void ToggleAdding() => adding = !adding;

    private async Task AddAsync(Track track)
    {
        await Playlists.AddTrackAsync(Id, track.Id);
        await ReloadAsync();
    }

    private async Task RemoveAsync(Track track)
    {
        await Playlists.RemoveTrackAsync(Id, track.Id);
        undoTrack = track;
        await ReloadAsync();
    }

    private void DismissUndo() => undoTrack = null;

    private async Task UndoAsync()
    {
        if (undoTrack is { } track)
        {
            undoTrack = null;
            await AddAsync(track);
        }
    }
}
