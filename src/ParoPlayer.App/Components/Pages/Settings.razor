@page "/settings"
@inject AppSettings Prefs
@inject ILibraryFolder LibraryFolder
@inject LibraryService Library
@inject DemoLibrary Demo

<PageHeader Title="Settings" />

<div class="px-4 pb-6">
    <ToggleRow Title="Download on Wi-Fi only" Description="Saves mobile data" Value="Prefs.WifiOnly" ValueChanged="value => Prefs.WifiOnly = value" />
    <ToggleRow Title="Gapless playback" Description="No silence between tracks" Value="Prefs.Gapless" ValueChanged="value => Prefs.Gapless = value" />
    <ToggleRow Title="Crossfade" Description="5 seconds" Value="Prefs.Crossfade" ValueChanged="value => Prefs.Crossfade = value" />
    <ToggleRow Title="Android Auto" Description="Show ParoPlayer in the car" Value="Prefs.AndroidAuto" ValueChanged="value => Prefs.AndroidAuto = value" />
    <ToggleRow Title="Lock screen controls" Description="Notification and lock screen player" Value="Prefs.LockScreenControls" ValueChanged="value => Prefs.LockScreenControls = value" />

    <h2 class="mb-2 mt-6 text-xs uppercase tracking-wider text-mute">Storage</h2>
    <div class="mb-3 rounded-2xl bg-panel2 p-3">
        <div>@LibraryQuery.Pluralize(songCount, "song") · @LibraryQuery.FormatSize(usedBytes) used</div>
        <div class="mt-1 break-all text-xs text-mute">Library folder: @LibraryFolder.Path</div>
    </div>

    <ImportButton OnImported="LoadStorageAsync" />

    @if (IsDebug)
    {
        <button type="button" class="mt-2 flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-panel2 font-semibold" @onclick="LoadDemoAsync">
            <i class="fa-solid fa-flask" aria-hidden="true"></i>Load demo songs
        </button>
    }
</div>

@code {
#if DEBUG
    private const bool IsDebug = true;
#else
    private const bool IsDebug = false;
#endif

    private int songCount;
    private long usedBytes;

    protected override async Task OnInitializedAsync()
    {
        await LoadStorageAsync();
    }

    private async Task LoadStorageAsync()
    {
        songCount = (await Library.GetAllAsync()).Count;
        usedBytes = await LibraryStorage.MeasureAsync(LibraryFolder);
    }

    private async Task LoadDemoAsync()
    {
        await Demo.AddAsync();
        await LoadStorageAsync();
    }
}
