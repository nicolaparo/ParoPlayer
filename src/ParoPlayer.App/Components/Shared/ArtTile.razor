@inject CoverImages Covers

<div class="@SizeClass relative flex shrink-0 items-center justify-center overflow-hidden rounded-lg font-display font-bold text-white/90" style="@Background" aria-hidden="true">
    @if (coverUri is not null)
    {
        <img src="@coverUri" alt="" class="absolute inset-0 size-full object-cover" />
    }
    else if (Smart)
    {
        <i class="fa-solid fa-wand-magic-sparkles"></i>
    }
    else
    {
        @Initials
    }
</div>

@code {
    [Parameter] public string Seed { get; set; } = "";

    [Parameter] public bool Smart { get; set; }

    /// <summary>Cover file of the track; the generated tile is shown while it loads or when it is empty.</summary>
    [Parameter] public string CoverPath { get; set; } = "";

    private string? coverUri;

    protected override async Task OnParametersSetAsync() => coverUri = await Covers.GetAsync(CoverPath);

    [Parameter] public string SizeClass { get; set; } = "size-12 text-base";

    private string Background => $"background:linear-gradient(135deg,hsl({Hue} 45% 38%),#161a22)";

    private int Hue
    {
        get
        {
            var hash = 7;
            foreach (var c in Seed)
            {
                hash = unchecked((hash * 31) + c);
            }

            return Math.Abs(hash % 360);
        }
    }

    private string Initials => new(Seed
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(word => char.ToUpperInvariant(word.FirstOrDefault(char.IsLetterOrDigit)))
        .Where(c => c != '\0')
        .ToArray());
}
