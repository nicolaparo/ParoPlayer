@inject HostShell Shell
<nav class="shrink-0 border-t border-line bg-panel pb-safe" aria-label="Main">
    <div class="grid @(Shell.ShowSettings ? "grid-cols-4" : "grid-cols-3")">
        <NavLink href="/" Match="NavLinkMatch.All" aria-label="Library" class="flex min-h-12 min-w-12 flex-col items-center justify-center gap-1 py-2 text-mute" ActiveClass="text-accent">
            <i class="fa-solid fa-music text-xl" aria-hidden="true"></i>
            <span class="text-xs">Library</span>
        </NavLink>
        <NavLink href="/playlists" aria-label="Playlists" class="flex min-h-12 min-w-12 flex-col items-center justify-center gap-1 py-2 text-mute" ActiveClass="text-accent">
            <i class="fa-solid fa-list text-xl" aria-hidden="true"></i>
            <span class="text-xs">Playlists</span>
        </NavLink>
        <NavLink href="/download" aria-label="Download" class="flex min-h-12 min-w-12 flex-col items-center justify-center gap-1 py-2 text-mute" ActiveClass="text-accent">
            <i class="fa-solid fa-download text-xl" aria-hidden="true"></i>
            <span class="text-xs">Download</span>
        </NavLink>
        @if (Shell.ShowSettings)
        {
            <NavLink href="/settings" aria-label="Settings" class="flex min-h-12 min-w-12 flex-col items-center justify-center gap-1 py-2 text-mute" ActiveClass="text-accent">
                <i class="fa-solid fa-gear text-xl" aria-hidden="true"></i>
                <span class="text-xs">Settings</span>
            </NavLink>
        }
    </div>
</nav>
