@using ParoPlayer.Core.Import
<div class="pointer-events-none flex size-full items-center gap-px" aria-hidden="true">
    @{
        var bars = Peaks ?? Flat;
        var played = (int)Math.Round(Math.Clamp(Progress, 0, 1) * bars.Length);
    }
    @for (var i = 0; i < bars.Length; i++)
    {
        var known = bars[i] >= 0f;
        var height = (int)Math.Round(8 + Math.Clamp(known ? bars[i] : 0.5f, 0f, 1f) * 92);
        <span class="@(i < played ? "bg-accent" : "bg-line") @(Loading && !known ? "animate-pulse" : "") flex-1 rounded-full" style="height:@(height)%"></span>
    }
</div>

@code {
    /// <summary>Shown at half height while the real levels are being computed, so the track can still be seeked.</summary>
    private static readonly float[] Flat = [.. Enumerable.Repeat(WaveformStore.Unknown, 150)];

    /// <summary>Bar heights between 0 and 1; a negative value is a bar not computed yet. Null before any is known or when they cannot be.</summary>
    [Parameter] public float[]? Peaks { get; set; }

    /// <summary>True while the levels are being computed: the bars not known yet pulse softly.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>Played part of the track, between 0 and 1.</summary>
    [Parameter] public double Progress { get; set; }
}
