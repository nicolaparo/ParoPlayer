<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Android is the product; Windows is only the local dev/preview target. -->
        <TargetFrameworks>net11.0-android</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>ParoPlayer.App</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Generate C# from XAML at compile time (faster builds and startup). -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <ApplicationTitle>ParoPlayer</ApplicationTitle>
        <ApplicationId>com.nicolaparo.paroplayer</ApplicationId>

        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- Unpackaged on Windows: run with `dotnet build -t:Run`, no MSIX needed. -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0c0e12" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0c0e12" BaseSize="128,128" />
        <MauiImage Include="Resources\Images\*" />
        <MauiFont Include="Resources\Fonts\*" />
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="Microsoft.Maui.DevFlow.Agent" Version="0.1.0-preview.13.26526.5" Condition="'$(Configuration)' == 'Debug'" />
        <PackageReference Include="Microsoft.Maui.DevFlow.Blazor" Version="0.1.0-preview.13.26526.5" Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>

    <!-- Native playback (AndroidX Media3). The packages list net10.0-android36.0; they restore for net11.0-android37. -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <PackageReference Include="Xamarin.AndroidX.Media3.Common" Version="1.11.1" />
        <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.11.1" />
        <PackageReference Include="Xamarin.AndroidX.Media3.Session" Version="1.11.1" />
        <!-- Media3 raises Xamarin.AndroidX.Core to 1.19.0.1 (core-ktx classes are merged into it) while MAUI keeps
             Core.Core.Ktx at 1.17.0.2; D8 then fails with "Type androidx.core.animation.AnimatorKt$addListener$2 is defined
             multiple times". Raising Core.Core.Ktx to the same version removes the duplicate. -->
        <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" />
    </ItemGroup>

    <!-- ffmpeg CLI (hzw1199/Android-FFmpeg-Prebuilt, see docs/download.md for source and checksum). Packaged as a native
         library so Android extracts it to the app's native library dir, the only place an app may execute files from.
         Without the file the build still works and downloads are kept unconverted. -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And Exists('Platforms\Android\lib\arm64-v8a\libffmpeg.so')">
        <AndroidNativeLibrary Include="Platforms\Android\lib\arm64-v8a\libffmpeg.so" Abi="arm64-v8a" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ParoPlayer.Core\ParoPlayer.Core.csproj" />
    </ItemGroup>

    <!-- Browser session (#26): Kestrel + Blazor Server. Windows uses the installed shared framework. Android has no
         ASP.NET Core runtime pack, so the (portable, managed) assemblies of the win-x64 pack are referenced and shipped. -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <PropertyGroup>
        <AspNetPackVersion>11.0.0-preview.6.26359.118</AspNetPackVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageDownload Include="Microsoft.AspNetCore.App.Internal.Assets" Version="[$(AspNetPackVersion)]" />
        <MauiAsset Include="$(NuGetPackageRoot)microsoft.aspnetcore.app.internal.assets/$(AspNetPackVersion)/staticwebassets/_framework/blazor.web.js" LogicalName="browser/blazor.web.js" />
    </ItemGroup>
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <AspNetPackDir>$(NuGetPackageRoot)microsoft.aspnetcore.app.runtime.linux-arm64/$(AspNetPackVersion)/runtimes/linux-arm64/lib/net11.0/</AspNetPackDir>
    </PropertyGroup>
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <PackageDownload Include="Microsoft.AspNetCore.App.Runtime.linux-arm64" Version="[$(AspNetPackVersion)]" />
        <AspNetDll Include="$(AspNetPackDir)*.dll" />
        <Reference Include="@(AspNetDll)" />
    </ItemGroup>

    <!-- Tailwind: wwwroot/css/app.css is generated AND committed (wwwroot is globbed at evaluation time,
         so the file must already exist on a fresh clone). When node_modules is present, rebuild it
         whenever a Razor file or Styles/app.css changed. Run `npm install` once to enable this. -->
    <ItemGroup>
        <TailwindInputs Include="Styles\app.css;Components\**\*.razor" />
    </ItemGroup>
    <Target Name="BuildTailwind" BeforeTargets="BeforeBuild" Condition="Exists('$(MSBuildProjectDirectory)\node_modules')"
            Inputs="@(TailwindInputs)" Outputs="wwwroot\css\app.css">
        <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
    </Target>

</Project>
